{
  "entities": {
    "UserPublicProfile": {
      "title": "UserPublicProfile",
      "description": "Publicly visible Carrom Hub player profile without PII.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fullName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "username": { "type": "string", "minLength": 3, "maxLength": 32, "pattern": "^[a-zA-Z0-9_\\.]+$" },
        "usernameLower": { "type": "string", "minLength": 3, "maxLength": 32 },
        "carromPlayerId": { "type": "string", "maxLength": 40 },
        "bio": { "type": "string", "maxLength": 300 },
        "facebookUrl": { "type": "string", "maxLength": 200 },
        "tiktokUrl": { "type": "string", "maxLength": 200 },
        "instagramUrl": { "type": "string", "maxLength": 200 },
        "avatarUrl": { "type": "string", "maxLength": 600000 },
        "coverUrl": { "type": "string", "maxLength": 600000 },
        "isVerified": { "type": "boolean" },
        "isSuspended": { "type": "boolean" },
        "isBanned": { "type": "boolean" },
        "followersCount": { "type": "number" },
        "followingCount": { "type": "number" },
        "postsCount": { "type": "number" },
        "tournamentsWon": { "type": "number" },
        "privacy": { "type": "string", "enum": ["public", "friends"] },
        "badges": { "type": "array" },
        "lastSeenAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "fullName", "username", "usernameLower", "isVerified", "isSuspended", "isBanned", "followersCount", "followingCount", "postsCount", "tournamentsWon", "privacy", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated private PII and personal settings for a user.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "phoneNumber": { "type": "string", "maxLength": 30 },
        "rememberMe": { "type": "boolean" },
        "blockedUserIds": { "type": "array" },
        "notificationsEnabled": { "type": "boolean" },
        "showOnlineStatus": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "blockedUserIds", "notificationsEnabled", "showOnlineStatus", "updatedAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Server-verified administrator role document.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "role": { "type": "string", "enum": ["super_admin", "moderator"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role", "createdAt"]
    },
    "FollowRelation": {
      "title": "FollowRelation",
      "description": "Follower or following relationship edge.",
      "type": "object",
      "properties": {
        "actorId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "targetId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["actorId", "targetId", "createdAt"]
    },
    "Story": {
      "title": "Story",
      "description": "24-hour expiring player story.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "authorUsername": { "type": "string", "minLength": 1, "maxLength": 32 },
        "authorAvatar": { "type": "string", "maxLength": 600000 },
        "mediaUrl": { "type": "string", "minLength": 1, "maxLength": 600000 },
        "mediaType": { "type": "string", "enum": ["image", "video"] },
        "caption": { "type": "string", "maxLength": 200 },
        "expiresAtMs": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "authorId", "authorName", "authorUsername", "mediaUrl", "mediaType", "expiresAtMs", "createdAt"]
    },
    "Post": {
      "title": "Post",
      "description": "Social feed post or community group post.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "authorUsername": { "type": "string", "minLength": 1, "maxLength": 32 },
        "authorAvatar": { "type": "string", "maxLength": 600000 },
        "authorVerified": { "type": "boolean" },
        "caption": { "type": "string", "maxLength": 2000 },
        "mediaUrl": { "type": "string", "maxLength": 600000 },
        "mediaType": { "type": "string", "enum": ["none", "image", "video"] },
        "audience": { "type": "string", "enum": ["public", "friends", "group"] },
        "groupId": { "type": "string", "maxLength": 128 },
        "groupName": { "type": "string", "maxLength": 80 },
        "likesCount": { "type": "number" },
        "commentsCount": { "type": "number" },
        "sharesCount": { "type": "number" },
        "reactionSummary": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "authorId", "authorName", "authorUsername", "caption", "mediaType", "audience", "likesCount", "commentsCount", "sharesCount", "createdAt", "updatedAt"]
    },
    "PostReaction": {
      "title": "PostReaction",
      "description": "Reaction by a user on a post.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "type": { "type": "string", "enum": ["like", "queen", "fire", "clap", "wow"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "type", "createdAt"]
    },
    "PostComment": {
      "title": "PostComment",
      "description": "Comment on a post.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "postId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "authorName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "authorUsername": { "type": "string", "minLength": 1, "maxLength": 32 },
        "authorAvatar": { "type": "string", "maxLength": 600000 },
        "text": { "type": "string", "minLength": 1, "maxLength": 800 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "postId", "authorId", "authorName", "authorUsername", "text", "createdAt"]
    },
    "Report": {
      "title": "Report",
      "description": "Abuse or content report submitted by a user.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "reporterId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "targetType": { "type": "string", "enum": ["post", "user", "group"] },
        "targetId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "reason": { "type": "string", "minLength": 2, "maxLength": 120 },
        "details": { "type": "string", "maxLength": 600 },
        "status": { "type": "string", "enum": ["pending", "reviewed", "dismissed", "action_taken"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "reporterId", "targetType", "targetId", "reason", "status", "createdAt", "updatedAt"]
    },
    "CommunityGroup": {
      "title": "CommunityGroup",
      "description": "Carrom community group.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 80 },
        "description": { "type": "string", "maxLength": 600 },
        "logoUrl": { "type": "string", "maxLength": 600000 },
        "coverUrl": { "type": "string", "maxLength": 600000 },
        "privacy": { "type": "string", "enum": ["public", "private"] },
        "adminId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "conversationId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "membersCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "description", "privacy", "adminId", "conversationId", "membersCount", "createdAt", "updatedAt"]
    },
    "GroupMember": {
      "title": "GroupMember",
      "description": "Membership record inside a community group.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "role": { "type": "string", "enum": ["admin", "member"] },
        "fullName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "username": { "type": "string", "minLength": 1, "maxLength": 32 },
        "avatarUrl": { "type": "string", "maxLength": 600000 },
        "joinedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "role", "fullName", "username", "joinedAt"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Private 1-on-1 or Group chat thread.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "type": { "type": "string", "enum": ["private", "group"] },
        "name": { "type": "string", "maxLength": 80 },
        "avatarUrl": { "type": "string", "maxLength": 600000 },
        "adminId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "groupId": { "type": "string", "maxLength": 128 },
        "participantIds": { "type": "array" },
        "participantProfiles": { "type": "object" },
        "lastMessageText": { "type": "string", "maxLength": 300 },
        "lastMessageAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "type", "adminId", "participantIds", "createdAt", "updatedAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Real-time message inside a conversation.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "conversationId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "senderId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "senderName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "senderAvatar": { "type": "string", "maxLength": 600000 },
        "text": { "type": "string", "maxLength": 2000 },
        "mediaUrl": { "type": "string", "maxLength": 600000 },
        "mediaType": { "type": "string", "enum": ["text", "image", "video", "voice"] },
        "replyToId": { "type": "string", "maxLength": 128 },
        "replyToText": { "type": "string", "maxLength": 200 },
        "replyToSender": { "type": "string", "maxLength": 80 },
        "reactions": { "type": "object" },
        "readBy": { "type": "array" },
        "participantIds": { "type": "array" },
        "deleted": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "conversationId", "senderId", "senderName", "text", "mediaType", "readBy", "participantIds", "deleted", "createdAt", "updatedAt"]
    },
    "Tournament": {
      "title": "Tournament",
      "description": "Carrom Pool tournament with verified results.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 3, "maxLength": 100 },
        "description": { "type": "string", "maxLength": 800 },
        "entryInfo": { "type": "string", "minLength": 2, "maxLength": 200 },
        "rules": { "type": "string", "minLength": 5, "maxLength": 1500 },
        "coverUrl": { "type": "string", "maxLength": 600000 },
        "creatorId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "status": { "type": "string", "enum": ["upcoming", "ongoing", "pending_verification", "completed"] },
        "maxPlayers": { "type": "number" },
        "participantsCount": { "type": "number" },
        "winnerId": { "type": "string", "maxLength": 128 },
        "winnerName": { "type": "string", "maxLength": 80 },
        "winnerVerified": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "entryInfo", "rules", "creatorId", "status", "maxPlayers", "participantsCount", "winnerVerified", "createdAt", "updatedAt"]
    },
    "TournamentParticipant": {
      "title": "TournamentParticipant",
      "description": "Registered participant in a tournament.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fullName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "username": { "type": "string", "minLength": 1, "maxLength": 32 },
        "avatarUrl": { "type": "string", "maxLength": 600000 },
        "carromPlayerId": { "type": "string", "maxLength": 40 },
        "wins": { "type": "number" },
        "points": { "type": "number" },
        "joinedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "fullName", "username", "wins", "points", "joinedAt"]
    },
    "TournamentMatchResult": {
      "title": "TournamentMatchResult",
      "description": "Submitted tournament match score awaiting admin verification.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "tournamentId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "submittedBy": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "opponentName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "claimedWinnerId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "claimedWinnerName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "scoreSummary": { "type": "string", "minLength": 2, "maxLength": 120 },
        "verificationStatus": { "type": "string", "enum": ["pending", "verified", "rejected"] },
        "verifiedBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "tournamentId", "submittedBy", "opponentName", "claimedWinnerId", "claimedWinnerName", "scoreSummary", "verificationStatus", "createdAt", "updatedAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User notification item.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "recipientId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "actorId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "actorName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "actorAvatar": { "type": "string", "maxLength": 600000 },
        "type": { "type": "string", "enum": ["follow", "like", "comment", "message", "group_invite", "tournament", "mention"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "body": { "type": "string", "minLength": 1, "maxLength": 300 },
        "linkTab": { "type": "string", "maxLength": 40 },
        "targetId": { "type": "string", "maxLength": 128 },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "recipientId", "actorId", "actorName", "type", "title", "body", "read", "createdAt"]
    },
    "PlatformSettings": {
      "title": "PlatformSettings",
      "description": "Global platform configuration managed by admins.",
      "type": "object",
      "properties": {
        "maintenanceMode": { "type": "boolean" },
        "allowRegistrations": { "type": "boolean" },
        "allowTournamentCreation": { "type": "boolean" },
        "announcementBanner": { "type": "string", "maxLength": 300 },
        "updatedBy": { "type": "string", "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["maintenanceMode", "allowRegistrations", "allowTournamentCreation", "announcementBanner", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserPublicProfile" },
      "description": "Public player profile documents."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Private PII and user settings isolated per user."
    },
    "/users/{userId}/followers/{followerId}": {
      "schema": { "$ref": "#/entities/FollowRelation" },
      "description": "Followers of a user."
    },
    "/users/{userId}/following/{targetId}": {
      "schema": { "$ref": "#/entities/FollowRelation" },
      "description": "Users followed by a user."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Trusted admin RBAC registry."
    },
    "/stories/{storyId}": {
      "schema": { "$ref": "#/entities/Story" },
      "description": "24-hour player stories."
    },
    "/posts/{postId}": {
      "schema": { "$ref": "#/entities/Post" },
      "description": "Social feed and community posts."
    },
    "/posts/{postId}/reactions/{userId}": {
      "schema": { "$ref": "#/entities/PostReaction" },
      "description": "Per-user reactions on a post."
    },
    "/posts/{postId}/comments/{commentId}": {
      "schema": { "$ref": "#/entities/PostComment" },
      "description": "Comments on a post."
    },
    "/reports/{reportId}": {
      "schema": { "$ref": "#/entities/Report" },
      "description": "User-submitted moderation reports."
    },
    "/groups/{groupId}": {
      "schema": { "$ref": "#/entities/CommunityGroup" },
      "description": "Carrom community groups."
    },
    "/groups/{groupId}/members/{memberId}": {
      "schema": { "$ref": "#/entities/GroupMember" },
      "description": "Community group member list."
    },
    "/conversations/{conversationId}": {
      "schema": { "$ref": "#/entities/Conversation" },
      "description": "Private and group chat threads."
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Messages within a conversation."
    },
    "/tournaments/{tournamentId}": {
      "schema": { "$ref": "#/entities/Tournament" },
      "description": "Carrom Pool tournaments."
    },
    "/tournaments/{tournamentId}/participants/{userId}": {
      "schema": { "$ref": "#/entities/TournamentParticipant" },
      "description": "Participants enrolled in a tournament."
    },
    "/tournaments/{tournamentId}/matches/{matchId}": {
      "schema": { "$ref": "#/entities/TournamentMatchResult" },
      "description": "Match result submissions pending admin verification."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "Real-time notifications scoped by recipientId."
    },
    "/platform_settings/{settingId}": {
      "schema": { "$ref": "#/entities/PlatformSettings" },
      "description": "Global platform configuration."
    }
  }
}
